msgid "Quadratic"
msgstr "تربيعي"

msgctxt "LatentGrowthCurve|"
msgid "Include a quadratic component in the model"
msgstr "إدراج مكوّن تربيعي في النموذج"

msgctxt "LatentGrowthCurve|"
msgid "Cubic"
msgstr "تكعيبي"

msgctxt "LatentGrowthCurve|"
msgid "Include a cubic component in the model"
msgstr "إدراج مكوّن تكعيبي في النموذج"

msgctxt "LatentGrowthCurve|"
msgid "Covarying latent curve"
msgstr "تغاير مكونات منحنى النمو الكامن"

msgctxt "LatentGrowthCurve|"
msgid "Include covariance between latent growth components"
msgstr "إدراج التغاير بين مكونات النمو الكامنة"

msgctxt "LatentGrowthCurve|"
msgid "Additional Output"
msgstr "مخرجات إضافية"

msgctxt "LatentGrowthCurve|"
msgid "Options for additional output"
msgstr "خيارات الناتج الإضافي"

msgctxt "LatentGrowthCurve|"
msgid "Additional fit measures"
msgstr "مقاييس مطابقة إضافية"

msgctxt "LatentGrowthCurve|"
msgid "Display additional model fit measures"
msgstr "عرض مقاييس إضافية لمطابقة النموذج"

msgctxt "LatentGrowthCurve|"
msgid "R-Squared"
msgstr "معامل التحديد"

msgctxt "LatentGrowthCurve|"
msgid "Display R-squared values for variables"
msgstr "عرض قيم معامل التحديد للمتغيرات"

msgctxt "LatentGrowthCurve|"
msgid "Standardized estimates"
msgstr "التقديرات المعيارية"

msgctxt "LatentGrowthCurve|"
msgid "Include standardized estimates in the output"
msgstr "إدراج التقديرات المعيارية في المخرجات"

msgctxt "LatentGrowthCurve|"
msgid "Select the type of standardized estimates to include"
msgstr "تحديد نوع التقديرات المعيارية المراد إدراجها"

msgctxt "LatentGrowthCurve|"
msgid "All"
msgstr "الكل"

msgctxt "LatentGrowthCurve|"
msgid "Include all standardized estimates"
msgstr "إدراج جميع التقديرات المعيارية"

msgctxt "LatentGrowthCurve|"
msgid "Latents"
msgstr "المتغيرات الكامنة"

msgctxt "LatentGrowthCurve|"
msgid "Include standardized estimates for latent variables only"
msgstr "إدراج التقديرات المعيارية للمتغيرات الكامنة فقط"

msgctxt "LatentGrowthCurve|"
msgid "Except exogenous covariates"
msgstr "باستثناء المتغيرات المصاحبة الخارجية"

msgctxt "LatentGrowthCurve|"
msgid "Exclude standardized estimates for exogenous covariates"
msgstr "استبعاد التقديرات المعيارية للمتغيرات المصاحبة الخارجية"

msgctxt "LatentGrowthCurve|"
msgid "Implied covariance matrix"
msgstr "مصفوفة التغاير الضمنية"

msgctxt "LatentGrowthCurve|"
msgid "Display the implied covariance matrix"
msgstr "عرض مصفوفة التغاير الضمنية"

msgctxt "LatentGrowthCurve|"
msgid "Residual covariance matrix"
msgstr "مصفوفة تغاير البواقي"

msgctxt "LatentGrowthCurve|"
msgid "Display the residual covariance matrix"
msgstr "عرض مصفوفة تغاير البواقي"

msgctxt "LatentGrowthCurve|"
msgid "Show lavaan syntax"
msgstr "عرض صياغة lavaan"

msgctxt "LatentGrowthCurve|"
msgid "Show the lavaan model syntax"
msgstr "عرض صياغة نموذج lavaan"

msgctxt "LatentGrowthCurve|"
msgid "Plots"
msgstr "المخططات"

msgctxt "LatentGrowthCurve|"
msgid "Options for generating plots"
msgstr "خيارات إنشاء الرسوم"

msgctxt "LatentGrowthCurve|"
msgid "Configure plot options for the analysis"
msgstr "ضبط خيارات الرسم للتحليل"

msgctxt "LatentGrowthCurve|"
msgid "Select a color palette for the plots"
msgstr "اختر لوحة ألوان للرسوم"

msgctxt "LatentGrowthCurve|"
msgid "Curve plot"
msgstr "رسم المنحنى"

msgctxt "LatentGrowthCurve|"
msgid "Generate a curve plot of the growth trajectories"
msgstr "إنشاء رسم لمنحنيات مسارات النمو"

msgctxt "LatentGrowthCurve|"
msgid "Select a categorical variable to color the curves"
msgstr "تحديد متغير فئوي لتلوين المنحنيات"

msgctxt "LatentGrowthCurve|"
msgid "Set the maximum number of lines to display in the curve plot"
msgstr "تعيين الحد الأقصى لعدد الخطوط المعروضة في مخطط المنحنيات"

msgctxt "LatentGrowthCurve|"
msgid "Misfit plot"
msgstr "رسم سوء المطابقة"

msgctxt "LatentGrowthCurve|"
msgid "Model plot"
msgstr "مخطط النموذج"

msgctxt "LatentGrowthCurve|"
