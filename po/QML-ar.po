msgctxt "Description|"
msgid "SEM"
msgstr "SEM"

msgctxt "Description|"
msgid "Evaluate latent data structures with Yves Rosseel’s lavaan program"
msgstr "تقييم بُنى البيانات الكامنة باستخدام برنامج lavaan لـYves Rosseel"

msgctxt "Description|"
msgid "Structural Equation Modeling"
msgstr "نمذجة المعادلات البنائية"

msgctxt "Description|"
msgid "Partial Least Squares SEM"
msgstr "نمذجة المعادلات البنائية بالمربعات الصغرى الجزئية"

msgctxt "Description|"
msgid "Mediation Analysis"
msgstr "تحليل الوساطة"

msgctxt "Description|"
msgid "MIMIC Model"
msgstr "نموذج MIMIC"

msgctxt "Description|"
msgid "Latent Growth"
msgstr "النمو الكامن"

msgctxt "Description|"
msgid "MNLFA"
msgstr "MNLFA"

msgctxt "Advanced|"
msgid "Advanced"
msgstr "متقدم"

msgctxt "Advanced|"
msgid "Missing value handling"
msgstr "معالجة القيم المفقودة"

msgctxt "Advanced|"
msgid "Select the method for handling missing data in estimation"
msgstr "تحديد طريقة معالجة البيانات المفقودة أثناء التقدير"

msgctxt "Advanced|"
msgid "(FI)ML"
msgstr "(FI)ML"

msgctxt "Advanced|"
msgid "Use Full Information Maximum Likelihood to handle missing data"
msgstr "استخدام الإمكان الأعظم بالمعلومات الكاملة لمعالجة البيانات المفقودة"

msgctxt "Advanced|"
msgid "Listwise"
msgstr "الحذف بالقائمة"

msgctxt "Advanced|"
msgid "Exclude cases with missing data (listwise deletion)"
msgstr ""
"استبعاد الحالات التي تفتقد قيمة في أي متغير من متغيرات التحليل (الحذف "
"بالقائمة)"

msgctxt "Advanced|"
msgid "Mimic"
msgstr "محاكاة"

msgctxt "Advanced|"
msgid "Select the software to emulate estimation behavior"
msgstr "تحديد البرنامج المراد محاكاة سلوكه في التقدير"

msgctxt "Advanced|"
msgid "Lavaan"
msgstr "Lavaan"

msgctxt "Advanced|"
msgid "Use Lavaan default estimation method"
msgstr "استخدام طريقة التقدير الافتراضية في lavaan"

msgctxt "Advanced|"
msgid "Mplus"
msgstr "Mplus"

msgctxt "Advanced|"
msgid "Emulate Mplus estimation methods"
msgstr "محاكاة طرق التقدير في Mplus"

msgctxt "Advanced|"
msgid "EQS"
msgstr "EQS"

msgctxt "Advanced|"
msgid "Emulate EQS estimation methods"
msgstr "محاكاة طرق التقدير في EQS"

msgctxt "Advanced|"
msgid "Estimator"
msgstr "المقدّر"

msgctxt "Advanced|"
msgid "Choose the estimator for model fitting"
msgstr "اختر المقدّر المستخدم لملاءمة النموذج"

msgctxt "Advanced|"
msgid "Default"
msgstr "افتراضي"

msgctxt "Advanced|"
msgid "Use the default estimator based on the model and data"
msgstr "استخدام المقدِّر الافتراضي الذي يستند إلى النموذج والبيانات"

msgctxt "Advanced|"
msgid "ML"
msgstr "ML"

msgctxt "Advanced|"
msgid "Maximum Likelihood estimator"
msgstr "مقدّر الإمكان الأعظم"

msgctxt "Advanced|"
msgid "GLS"
msgstr "GLS"

msgctxt "Advanced|"
msgid "Generalized Least Squares estimator"
msgstr "مقدّر المربعات الصغرى المعممة"

msgctxt "Advanced|"
msgid "WLS"
msgstr "WLS"

msgctxt "Advanced|"
msgid "Weighted Least Squares estimator"
msgstr "مقدّر المربعات الصغرى الموزونة"

msgctxt "Advanced|"
msgid "ULS"
msgstr "ULS"

msgctxt "Advanced|"
msgid "Unweighted Least Squares estimator"
msgstr "مقدّر المربعات الصغرى غير الموزونة"

msgctxt "Advanced|"
msgid "DWLS"
msgstr "DWLS"

msgctxt "Advanced|"
msgid "Diagonally Weighted Least Squares estimator"
msgstr "مقدّر المربعات الصغرى الموزونة قطريًا"

msgctxt "ErrorCalculation|"
msgid "Confidence intervals"
msgstr "فترات الثقة"

msgctxt "ErrorCalculation|"
msgid "Set the confidence level for the interval estimates"
msgstr "تحديد مستوى الثقة لفترات التقدير"

msgctxt "ErrorCalculation|"
msgid "Method"
msgstr "الطريقة"

msgctxt "ErrorCalculation|"
msgid ""
"Select the method for calculating standard errors and confidence intervals"
msgstr "تحديد طريقة حساب الأخطاء المعيارية وفترات الثقة"

msgctxt "ErrorCalculation|"
msgid "Standard"
msgstr "قياسي"

msgctxt "ErrorCalculation|"
msgid "Use standard maximum likelihood estimation for standard errors"
msgstr "استخدام تقدير الإمكان الأعظم المعتاد لحساب الأخطاء المعيارية"

msgctxt "ErrorCalculation|"
msgid "Robust"
msgstr "حصين"

msgctxt "ErrorCalculation|"
msgid "Use robust estimation for standard errors"
msgstr "استخدام التقدير الحصين لحساب الأخطاء المعيارية"

msgctxt "ErrorCalculation|"
msgid "Bootstrap"
msgstr "التمهيد الإحصائي"

msgctxt "ErrorCalculation|"
msgid ""
"Use bootstrap method for estimating standard errors and confidence intervals"
msgstr "استخدام التمهيد الإحصائي لتقدير الأخطاء المعيارية وفترات الثقة"

msgctxt "ErrorCalculation|"
msgid "Replications"
msgstr "تكرارات"

msgctxt "ErrorCalculation|"
msgid "Specify the number of bootstrap samples"
msgstr "تحديد عدد عينات التمهيد الإحصائي"

msgctxt "ErrorCalculation|"
msgid "Type"
msgstr "النوع"

msgctxt "ErrorCalculation|"
msgid "Bias-corrected percentile"
msgstr "المئين المصحح للتحيز"

msgctxt "ErrorCalculation|"
msgid "Percentile"
msgstr "المئين"

msgctxt "ErrorCalculation|"
msgid "Normal theory"
msgstr "نظرية التوزيع الطبيعي"

msgctxt "ErrorCalculation|"
msgid "Select the type of bootstrap confidence interval to compute"
msgstr "تحديد نوع فترة الثقة المراد حسابها بالتمهيد الإحصائي"

msgctxt "LatentGrowthCurve|"
msgid "Variables"
msgstr "المتغيرات"

msgctxt "LatentGrowthCurve|"
msgid "Variables to include in the latent growth curve model"
msgstr "المتغيرات المراد إدراجها في نموذج منحنى النمو الكامن"

msgctxt "LatentGrowthCurve|"
msgid "Regressions"
msgstr "الانحدارات"

