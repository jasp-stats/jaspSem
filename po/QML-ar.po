msgid "Show parameter estimates"
msgstr "إظهار تقديرات المعلمات"

msgctxt "LatentGrowthCurve|"
msgid "Display parameter estimates in the model plot"
msgstr "عرض تقديرات المعلمات في رسم النموذج"

msgctxt "LatentGrowthCurve|"
msgid "Show means"
msgstr "عرض المتوسطات"

msgctxt "LatentGrowthCurve|"
