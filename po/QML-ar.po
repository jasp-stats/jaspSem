msgctxt "LatentGrowthCurve|"
msgid "Factor"
msgstr "العامل"

msgctxt "LatentGrowthCurve|"
msgid "Categorical variables acting as factors"
msgstr "المتغيرات المصنفة التي تعمل كعوامل"

msgctxt "LatentGrowthCurve|"
msgid "Time-varying covariates"
msgstr "المتغيرات المصاحبة المتغيرة عبر الزمن"

