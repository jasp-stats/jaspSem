msgctxt "MediationAnalysis|"
msgid ""
"One or multiple predictor variables predicting the mediators and the outcome "
"variables."
msgstr ""
"Une ou plusieurs variables prédictrices prédisant les médiateurs et les "
"variables de résultat."

msgctxt "MediationAnalysis|"
msgid ""
"Variables through which the indirect effect of the predictors on the "
"outcomes is hypothesized to flow."
msgstr ""
"Variables par lesquelles l'effet indirect des prédicteurs sur les résultats "
"est supposé circuler."

msgctxt "MediationAnalysis|"
msgid "Variables predicted by the predictors and the mediators."
msgstr "Variables prédites par les prédicteurs et les médiateurs."

msgctxt "MediationAnalysis|"
msgid ""
"Variables explaining the predictors, mediators, and outcomes. Direct, "
"indirect, and total effects are estimated conditional on these variables."
msgstr ""
"Variables expliquant les prédicteurs, les médiateurs et les résultats. Les "
"effets directs, indirects et totaux sont estimés conditionnellement à ces "
"variables."

msgctxt "MediationAnalysis|"
msgid ""
"Options for standardization, additional parameter estimates, and model "
"display."
msgstr ""
"Options de standardisation, d'estimations de paramètres supplémentaires et "
"d'affichage du modèle."

msgctxt "MediationAnalysis|"
msgid "Standardize all variables (mean = 0, sd = 1) before estimation."
msgstr ""
"Standardiser toutes les variables (moyenne = 0, écart-type = 1) avant "
"l'estimation."

msgctxt "MediationAnalysis|"
msgid "Type of standardization."
msgstr "Type de standardisation."

msgctxt "MediationAnalysis|"
msgid "Standardize based on variances of both observed and latent variables."
msgstr ""
"Standardiser en fonction des variances des variables observées et latentes."

msgctxt "MediationAnalysis|"
msgid "Standardize based on latent variable variances only."
msgstr "Standardiser en fonction des variances des seules variables latentes."

msgctxt "MediationAnalysis|"
msgid "Standardize excluding exogenous covariates."
msgstr "Standardiser en excluant les covariables exogènes."

msgctxt "MediationAnalysis|"
msgid "Display the lavaan syntax used to estimate the model."
msgstr "Afficher la syntaxe lavaan utilisée pour estimer le modèle."

msgctxt "MediationAnalysis|"
msgid ""
"Display the proportion of variance explained for each endogenous variable."
msgstr ""
"Afficher la proportion de variance expliquée pour chaque variable endogène."

msgctxt "MediationAnalysis|"
msgid "Additional parameter estimate tables to display."
msgstr "Tableaux d'estimations de paramètres supplémentaires à afficher."

msgctxt "MediationAnalysis|"
msgid "Display total indirect effects summed across all mediators."
msgstr ""
"Afficher les effets indirects totaux additionnés sur tous les médiateurs."

msgctxt "MediationAnalysis|"
msgid "Display residual covariances between variables."
msgstr "Afficher les covariances résiduelles entre les variables."

msgctxt "MediationAnalysis|"
msgid "Display the path coefficients of the model."
msgstr "Afficher les coefficients de chemins du modèle."

msgctxt "MediationAnalysis|"
msgid "Options for generating plots of the mediation model."
msgstr "Options de génération des graphiques du modèle de médiation."

msgctxt "MediationAnalysis|"
msgid "Display a path diagram of the mediation model."
msgstr "Afficher un diagramme de chemins du modèle de médiation."

msgctxt "MediationAnalysis|"
msgid "Display parameter estimates on the path diagram."
msgstr "Afficher les estimations des paramètres sur le diagramme de chemins."

msgctxt "MediationAnalysis|"
msgid "Display a legend in the path diagram."
msgstr "Afficher une légende dans le diagramme de chemins."

msgctxt "Mimic|"
msgid ""
"Observed indicator variables that define the latent variable in the MIMIC "
"model."
msgstr ""
"Variables indicatrices observées qui définissent la variable latente dans le "
"modèle MIMIC."

msgctxt "Mimic|"
msgid ""
"Observed predictor variables (causes) that directly influence the latent "
"variable."
msgstr ""
"Variables prédictrices observées (causes) qui influencent directement la "
"variable latente."

msgctxt "Mimic|"
msgid ""
"Options for standardization, model syntax display, and additional output."
msgstr ""
"Options de standardisation, d'affichage de la syntaxe du modèle et de sortie "
"supplémentaire."

msgctxt "Mimic|"
msgid "Standardize all variables (mean = 0, sd = 1) before estimation."
msgstr ""
"Standardiser toutes les variables (moyenne = 0, écart-type = 1) avant "
"l'estimation."

msgctxt "Mimic|"
msgid "Type of standardization."
msgstr "Type de standardisation."

msgctxt "Mimic|"
msgid "Standardize based on variances of both observed and latent variables."
msgstr ""
"Standardiser en fonction des variances des variables observées et latentes."

msgctxt "Mimic|"
msgid "Standardize based on latent variable variances only."
msgstr "Standardiser en fonction des variances des seules variables latentes."

msgctxt "Mimic|"
msgid "Standardize excluding exogenous covariates."
msgstr "Standardiser en excluant les covariables exogènes."

msgctxt "Mimic|"
msgid "Display the lavaan syntax used to estimate the model."
msgstr "Afficher la syntaxe lavaan utilisée pour estimer le modèle."

msgctxt "Mimic|"
msgid ""
"Display the proportion of variance explained for each endogenous variable."
msgstr ""
"Afficher la proportion de variance expliquée pour chaque variable endogène."

msgctxt "Mimic|"
msgid ""
"Display additional fit indices for evaluating model fit (e.g., CFI, TLI, "
"RMSEA, SRMR)."
msgstr ""
"Afficher des indices d'ajustement supplémentaires pour évaluer l'ajustement "
"du modèle (p. ex., CFI, TLI, RMSEA, SRMR)."

msgctxt "Mimic|"
msgid "Options for generating plots of the MIMIC model."
msgstr "Options de génération des graphiques du modèle MIMIC."

msgctxt "Mimic|"
msgid "Display a path diagram of the MIMIC model."
msgstr "Afficher un diagramme de chemins du modèle MIMIC."

msgctxt "Mimic|"
msgid "Display parameter estimates on the path diagram."
msgstr "Afficher les estimations des paramètres sur le diagramme de chemins."

msgctxt "Mimic|"
msgid "Display a legend in the path diagram."
msgstr "Afficher une légende dans le diagramme de chemins."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Define latent factors and assign observed indicator variables to each factor."
msgstr ""
"Définir des facteurs latents et assigner des variables indicatrices "
"observées à chaque facteur."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Specify moderator variables and their effects on measurement model "
"parameters."
msgstr ""
"Spécifier les variables modératrices et leurs effets sur les paramètres du "
"modèle de mesure."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Variables hypothesized to moderate the measurement model parameters. "
"Continuous moderators can optionally include squared and cubic effects."
msgstr ""
"Variables supposées modérer les paramètres du modèle de mesure. Les "
"modérateurs continus peuvent optionnellement inclure des effets quadratiques "
"et cubiques."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid "Include a quadratic (squared) effect for this moderator."
msgstr "Inclure un effet quadratique (au carré) pour ce modérateur."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid "Include a cubic effect for this moderator."
msgstr "Inclure un effet cubique pour ce modérateur."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Click to start or synchronize the analysis. The analysis does not run "
"automatically due to computational intensity."
msgstr ""
"Cliquez pour démarrer ou synchroniser l'analyse. L'analyse ne s'exécute pas "
"automatiquement en raison de son exigence en calcul."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Check measurement invariance assumptions by testing model fit across groups "
"defined by the moderator variables."
msgstr ""
"Vérifier les hypothèses d'invariance de mesure en testant l'ajustement du "
"modèle entre les groupes définis par les variables modératrices."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Fit the measurement model separately in each group to verify that the model "
"fits adequately before testing moderation."
msgstr ""
"Ajuster le modèle de mesure séparément dans chaque groupe pour vérifier que "
"le modèle s'ajuste convenablement avant de tester la modération."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Number of groups into which continuous moderator variables are split for the "
"assumption check."
msgstr ""
"Nombre de groupes dans lesquels les variables modératrices continues sont "
"divisées pour la vérification des hypothèses."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Save the group variable created by splitting the continuous moderator to the "
"dataset."
msgstr ""
"Enregistrer la variable de groupe créée en divisant le modérateur continu "
"dans l'ensemble de données."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid "Include interaction terms between pairs of moderators."
msgstr "Inclure des termes d'interaction entre les paires de modérateurs."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Configure invariance test levels and specify which individual parameters "
"should be tested for moderation."
msgstr ""
"Configurer les niveaux du test d'invariance et spécifier quels paramètres "
"individuels doivent être testés pour la modération."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Select the levels of measurement invariance to test. Each level constrains "
"an additional set of parameters to be equal across moderator values."
msgstr ""
"Sélectionner les niveaux d'invariance de mesure à tester. Chaque niveau "
"contraint un ensemble supplémentaire de paramètres à être égal entre les "
"valeurs du modérateur."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Test configural invariance: same factor structure across groups but all "
"parameters free."
msgstr ""
"Tester l'invariance configurationnelle : même structure factorielle entre "
"les groupes mais tous les paramètres libres."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Test metric invariance: constrain factor loadings to be equal across groups."
msgstr ""
"Tester l'invariance métrique : contraindre les saturations factorielles à "
"être égales entre les groupes."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Test scalar invariance: constrain factor loadings and intercepts to be equal "
"across groups."
msgstr ""
"Tester l'invariance scalaire : contraindre les saturations factorielles et "
"les interceptes à être égaux entre les groupes."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"Test strict invariance: constrain factor loadings, intercepts, and residual "
"variances to be equal across groups."
msgstr ""
"Tester l'invariance stricte : contraindre les saturations factorielles, les "
"interceptes et les variances résiduelles à être égaux entre les groupes."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid "Define a custom set of parameter constraints for invariance testing."
msgstr ""
"Définir un ensemble personnalisé de contraintes de paramètres pour le test "
"d'invariance."

msgctxt "ModeratedNonLinearFactorAnalysis|"
msgid ""
"For each invariance level, specify which individual measurement parameters "
"should be tested for moderation effects."
msgstr ""
"Pour chaque niveau d'invariance, spécifier quels paramètres de mesure "
"individuels doivent être testés pour les effets de modération."

